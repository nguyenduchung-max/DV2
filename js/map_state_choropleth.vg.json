{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 460,
  "projection": {
    "type": "conicEqualArea",
    "rotate": [-134, 0],
    "parallels": [-18, -36]
  },
  "layer": [
    {
      "data": {
        "url": "data/states_abs.geojson",
        "format": {"type": "json", "property": "features"}
      },
      "transform": [
        {"filter": "datum.properties.state_name_2021 != 'Other Territories' && datum.properties.state_name_2021 != 'Outside Australia'"},
        {
          "lookup": "properties.state_name_2021",
          "from": {
            "data": {
              "values": [
                {"state": "Australian Capital Territory", "rate2024": 58.2, "rate2025": 59.2},
                {"state": "New South Wales", "rate2024": 47.3, "rate2025": 47.9},
                {"state": "Northern Territory", "rate2024": 50.4, "rate2025": 54.4},
                {"state": "Queensland", "rate2024": 47.2, "rate2025": 49.6},
                {"state": "South Australia", "rate2024": 46.1, "rate2025": 48.6},
                {"state": "Tasmania", "rate2024": 53.3, "rate2025": 51.3},
                {"state": "Victoria", "rate2024": 49.7, "rate2025": 51.7},
                {"state": "Western Australia", "rate2024": 48.3, "rate2025": 52.5}
              ]
            },
            "key": "state",
            "fields": ["rate2024", "rate2025"]
          }
        },
        {"calculate": "datum.rate2025 - datum.rate2024", "as": "Change"},
        {
          "calculate": "datum.rate2025 < 50 ? 'Under 50' : datum.rate2025 < 53 ? '50 to 53' : datum.rate2025 < 56 ? '53 to 56' : '56 and above'",
          "as": "band"
        }
      ],
      "mark": {"type": "geoshape", "stroke": "white", "strokeWidth": 1},
      "encoding": {
        "color": {
          "field": "band",
          "type": "ordinal",
          "title": "% active 3+ times a week",
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "symbolType": "square",
            "symbolSize": 170
          },
          "scale": {
            "domain": ["Under 50", "50 to 53", "53 to 56", "56 and above"],
            "range": ["#eff3ff", "#9ecae1", "#4292c6", "#08519c"]
          }
        },
        "tooltip": [
          {"field": "properties.state_name_2021", "type": "nominal", "title": "State"},
          {"field": "rate2025", "type": "quantitative", "title": "2025 (%)", "format": ".1f"},
          {"field": "rate2024", "type": "quantitative", "title": "2024 (%)", "format": ".1f"},
          {"field": "Change", "type": "quantitative", "title": "Change (pts)", "format": "+.1f"}
        ]
      }
    },
    {
      "data": {
        "values": [
          {"lon": 147.5, "lat": -42.3, "lon2": 149.9, "lat2": -42.3},
          {"lon": 149.1, "lat": -35.5, "lon2": 152.3, "lat2": -35.5}
        ]
      },
      "mark": {"type": "rule", "stroke": "#8d9aa5", "strokeWidth": 0.8},
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "longitude2": {"field": "lon2"},
        "latitude2": {"field": "lat2"}
      }
    },
    {
      "data": {
        "values": [
          {"abbr": "WA",  "lon": 121.5, "lat": -25.5, "onDark": false},
          {"abbr": "NT",  "lon": 133.5, "lat": -20.5, "onDark": true},
          {"abbr": "SA",  "lon": 135.5, "lat": -29.5, "onDark": false},
          {"abbr": "QLD", "lon": 144.5, "lat": -22.5, "onDark": false},
          {"abbr": "NSW", "lon": 146.5, "lat": -32.0, "onDark": false},
          {"abbr": "VIC", "lon": 144.3, "lat": -36.8, "onDark": false},
          {"abbr": "TAS", "lon": 150.6, "lat": -42.3, "onDark": false},
          {"abbr": "ACT", "lon": 153.0, "lat": -35.5, "onDark": false}
        ]
      },
      "mark": {"type": "text", "fontSize": 11, "fontWeight": 600},
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "text": {"field": "abbr", "type": "nominal"},
        "color": {
          "condition": {"test": "datum.onDark", "value": "white"},
          "value": "#2b3a4a"
        }
      }
    }
  ],
  "config": {"font": "Source Sans 3, sans-serif"}
}
