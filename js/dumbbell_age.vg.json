{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Active three or more times a week, by age group",
  "width": "container",
  "height": 300,
  "data": {
    "values": [
      {"age": "15-17", "rate2024": 44.6, "rate2025": 53.1},
      {"age": "18-24", "rate2024": 46.9, "rate2025": 48.9},
      {"age": "25-34", "rate2024": 48.7, "rate2025": 50.1},
      {"age": "35-44", "rate2024": 46.0, "rate2025": 47.6},
      {"age": "45-54", "rate2024": 50.9, "rate2025": 52.6},
      {"age": "55-64", "rate2024": 53.7, "rate2025": 56.9},
      {"age": "65+", "rate2024": 45.7, "rate2025": 46.0}
    ]
  },
  "encoding": {
    "y": {"field": "age", "type": "ordinal", "title": "Age group"}
  },
  "layer": [
    {
      "mark": {"type": "rule", "color": "#bbbbbb", "strokeWidth": 3},
      "encoding": {
        "x": {
          "field": "rate2024",
          "type": "quantitative",
          "title": "% of age group",
          "scale": {"domain": [40, 60]}
        },
        "x2": {"field": "rate2025"}
      }
    },
    {
      "transform": [
        {"fold": ["rate2024", "rate2025"], "as": ["Year", "Rate"]},
        {"calculate": "replace(datum.Year, 'rate', '')", "as": "Year"}
      ],
      "mark": {"type": "circle", "size": 120, "opacity": 1},
      "encoding": {
        "x": {"field": "Rate", "type": "quantitative"},
        "color": {
          "field": "Year",
          "type": "nominal",
          "scale": {"domain": ["2024", "2025"], "range": ["#9ecae1", "#08519c"]},
          "legend": {"orient": "bottom", "direction": "horizontal", "title": null}
        },
        "tooltip": [
          {"field": "age", "type": "nominal", "title": "Age group"},
          {"field": "Year", "type": "nominal"},
          {"field": "Rate", "type": "quantitative", "title": "Rate (%)", "format": ".1f"}
        ]
      }
    },
    {
      "mark": {"type": "text", "align": "left", "dx": 10, "fontSize": 11, "color": "#e6550d"},
      "encoding": {
        "x": {"field": "rate2025", "type": "quantitative"},
        "text": {"field": "Change", "type": "quantitative", "format": "+.1f"}
      },
      "transform": [{"calculate": "datum.rate2025 - datum.rate2024", "as": "Change"}]
    }
  ]
}
