{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 348,
  "data": {"url": "data/sa2_points_activity.csv"},
  "mark": {"type": "rect", "stroke": "white", "strokeWidth": 0.4},
  "encoding": {
    "x": {
      "field": "lon",
      "type": "quantitative",
      "bin": {"step": 0.8},
      "title": null,
      "scale": {"domain": [112, 154]},
      "axis": {"labels": false, "ticks": false, "grid": false, "domain": false}
    },
    "y": {
      "field": "lat",
      "type": "quantitative",
      "bin": {"step": 0.8},
      "title": null,
      "scale": {"domain": [-44, -9]},
      "axis": {"labels": false, "ticks": false, "grid": false, "domain": false}
    },
    "color": {
      "aggregate": "mean",
      "field": "pct_met",
      "type": "quantitative",
      "title": "% meeting the guidelines",
      "legend": {"orient": "bottom", "direction": "horizontal"},
      "scale": {
        "type": "threshold",
        "domain": [18, 21, 24, 27],
        "range": ["#eff3ff", "#bdd7e7", "#6baed6", "#3182bd", "#08519c"]
      }
    },
    "tooltip": [
      {"aggregate": "mean", "field": "pct_met", "type": "quantitative", "title": "Meeting guidelines (%)", "format": ".1f"},
      {"aggregate": "count", "type": "quantitative", "title": "Small areas in this cell"}
    ]
  },
  "config": {"font": "Source Sans 3, sans-serif", "view": {"stroke": null}}
}
