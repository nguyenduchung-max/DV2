            "type": "quantitative",
            "title": "% of adults",
            "format": ".2f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.pct >= 15"
        }
      ],
      "mark": {
        "type": "rule",
        "stroke": "#9aa3ab",
        "strokeWidth": 0.7
      },
      "encoding": {
        "y": {
          "field": "offset",
          "type": "quantitative"
        },
        "y2": {
          "field": "labelY"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.pct >= 15"
        }
      ],
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "bottom",
        "dy": -3,
        "fontSize": 11,
        "color": "#22252a"
      },
      "encoding": {
        "y": {
          "field": "labelY",
          "type": "quantitative"
        },
        "text": {
          "field": "short",
          "type": "nominal"
        }
      }
    }
