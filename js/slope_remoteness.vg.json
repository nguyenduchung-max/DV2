{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 300,
  "data": {
    "values": [
      {"area": "Major cities", "year": "2024", "rate": 48.8},
      {"area": "Major cities", "year": "2025", "rate": 50.7},
      {"area": "Inner regional", "year": "2024", "rate": 47.3},
      {"area": "Inner regional", "year": "2025", "rate": 48.8},
      {"area": "Outer regional", "year": "2024", "rate": 46.3},
      {"area": "Outer regional", "year": "2025", "rate": 48.3},
      {"area": "Remote or very remote", "year": "2024", "rate": 47.1},
      {"area": "Remote or very remote", "year": "2025", "rate": 49.4}
    ]
  },
  "encoding": {
    "x": {
      "field": "year",
      "type": "ordinal",
      "title": null,
      "scale": {"padding": 0.35},
      "axis": {"labelAngle": 0, "domain": false, "ticks": false, "labelFontSize": 13}
    },
    "y": {
      "field": "rate",
      "type": "quantitative",
      "title": "% active 3+ times a week",
      "scale": {"domain": [44, 53]}
    },
    "color": {
      "field": "area",
      "type": "nominal",
      "title": null,
      "scale": {
        "domain": ["Major cities", "Inner regional", "Outer regional", "Remote or very remote"],
        "range": ["#08519c", "#3182bd", "#6baed6", "#e6550d"]
      },
      "legend": {"orient": "bottom", "direction": "horizontal", "columns": 2}
    }
  },
  "layer": [
    {
      "mark": {"type": "line", "strokeWidth": 2.5}
    },
    {
      "mark": {"type": "circle", "size": 90, "opacity": 1},
      "encoding": {
        "tooltip": [
          {"field": "area", "type": "nominal", "title": "Remoteness"},
          {"field": "year", "type": "nominal", "title": "Year"},
          {"field": "rate", "type": "quantitative", "title": "Rate (%)", "format": ".1f"}
        ]
      }
    },
    {
      "transform": [{"filter": "datum.year == '2025'"}],
      "mark": {"type": "text", "align": "left", "dx": 10, "fontSize": 11},
      "encoding": {
        "text": {"field": "rate", "type": "quantitative", "format": ".1f"}
      }
    }
  ],
  "config": {"font": "Source Sans 3, sans-serif"}
}
